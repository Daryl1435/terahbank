# ─────────────────────────────────────────────────────────────────────────────
# TerahBank — Environment Variables Example
# Copy this file to apps/api/.env and fill in real values.
# NEVER commit .env. See docs/env-schema.md for full documentation.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_ENV=development
APP_NAME=TerahBank API
APP_VERSION=1.0.0
DEBUG=true
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/terahbank
DATABASE_URL_READ=postgresql+asyncpg://USER:PASSWORD@localhost:5432/terahbank
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_DB=0
REDIS_CACHE_DB=1
REDIS_JOBS_DB=2

# JWT (generate keys: openssl genrsa -out jwt_private.pem 2048)
JWT_PRIVATE_KEY_PATH=/path/to/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/path/to/jwt_public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=RS256

# OTP
OTP_EXPIRE_MINUTES=5
OTP_MAX_RESEND_ATTEMPTS=3
OTP_SESSION_LOCK_MINUTES=30

# AWS
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_KYC_BUCKET=
AWS_S3_AUDIT_BUCKET=
AWS_KMS_KEY_ARN=
AWS_SES_SENDER_EMAIL=noreply@terahbank.com

# MTN Mobile Money
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_API_KEY=
MTN_MOMO_API_SECRET=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_COLLECTION_USER_ID=
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_WEBHOOK_SECRET=
MTN_MOMO_CALLBACK_URL=http://localhost:8000/api/v1/webhooks/mtn-momo
MTN_MOMO_TIMEOUT_SECONDS=120

# Orange Money
ORANGE_MONEY_BASE_URL=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_WEBHOOK_SECRET=
ORANGE_MONEY_CALLBACK_URL=http://localhost:8000/api/v1/webhooks/orange-money
ORANGE_MONEY_ENVIRONMENT=sandbox

# VISA / Card Issuing Partner
VISA_PARTNER_BASE_URL=
VISA_PARTNER_API_KEY=
VISA_PARTNER_API_SECRET=
VISA_PARTNER_WEBHOOK_SECRET=
VISA_PARTNER_CALLBACK_URL=http://localhost:8000/api/v1/webhooks/visa-card
VISA_PARTNER_MAX_CARDS_PER_USER=3

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@terahbank.com
SENDGRID_FROM_NAME=TerahBank

# SMS Gateway
SMS_GATEWAY_PROVIDER=twilio
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_API_SECRET=
SMS_GATEWAY_SENDER_ID=TerahBank

# FCM (Push Notifications)
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Insurance
INSURANCE_PARTNER_1_NAME=
INSURANCE_PARTNER_1_BASE_URL=
INSURANCE_PARTNER_1_API_KEY=
INSURANCE_PARTNER_1_COMMISSION_RATE=0.05

# Security
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_HOSTS=localhost,127.0.0.1

# BullMQ
BULLMQ_CONCURRENCY=5
BULLMQ_MAX_RETRY_ATTEMPTS=3
BULLMQ_RETRY_DELAY_MS=5000

# Feature Flags
FEATURE_MTN_MOMO=true
FEATURE_ORANGE_MONEY=false
FEATURE_VISA_CARD_PAYMENT=true
FEATURE_VIRTUAL_CARD=true
FEATURE_STANDARD_ACCOUNT=true
FEATURE_PROJECT_ACCOUNT=true
FEATURE_TERM_DEPOSIT=true
FEATURE_AUTO_SAVE=false
FEATURE_INSURANCE=false
FEATURE_MULTI_CARD=false
FEATURE_BIOMETRIC_AUTH=true
FEATURE_FRAUD_DETECTION=true
FEATURE_MAINTENANCE_MODE=false
FEATURE_READ_ONLY_MODE=false

# Monitoring
DATADOG_API_KEY=
DATADOG_SERVICE_NAME=terahbank-api
SENTRY_DSN=
